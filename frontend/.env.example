# Frontend environment (Vite exposes only VITE_*-prefixed vars to the client).
# Copy to .env.local for local dev; never commit real values.

# Base URL of the SwasthyaVaani backend API.
VITE_API_BASE_URL=http://localhost:8080

# WebSocket URL for realtime STT proxy (Phase 3).
VITE_API_WS_URL=ws://localhost:8080
