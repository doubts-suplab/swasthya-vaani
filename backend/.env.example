# Backend environment variables. Copy to backend/.env (git-ignored) or export in your shell.
# NEVER commit real secrets (CLAUDE.md §5, §7.2).

# --- Sarvam AI (required) ---
# Your Sarvam API subscription key. See docs/sarvam-integration.md.
SARVAM_API_KEY=

# --- Optional overrides (defaults live in application.yml) ---
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_REALTIME_URL=wss://api.sarvam.ai/speech-to-text/ws
# SARVAM_DEFAULT_LANGUAGE=bn-IN
# SERVER_PORT=8080

# --- AWS (Phase 5 deploy; region is pinned to ap-south-1) ---
# AWS_REGION=ap-south-1
